{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Master Pipeline (run.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Batch Scoring (Daily Job)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/batch_scoring.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Launch Review Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dashboard/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "-m",
            "args": ["unittest", "discover", "-s", "tests"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}